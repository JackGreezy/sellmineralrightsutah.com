.site-nav_2025 .nav-item_product.lv:hover .nav-link { border-color: rgb(118, 193, 255); background-color: rgb(36, 51, 66); }
.site-nav_2025 .nav-item-btn-primary1 a, .site-nav_2025 .nav-item-btn-primary1 button { cursor: pointer; font: 600 14px / 1 "IBM Plex Sans", sans-serif; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 4px; display: block; min-height: 40px; margin-top: auto; margin-bottom: auto; transition: 0.2s; box-sizing: border-box; width: 100%; max-width: 328px; text-align: center; background-color: rgb(242, 126, 48) !important; color: rgb(255, 255, 255) !important; }
.site-nav_2025 .nav-item-btn-primary1 a:hover, .site-nav_2025 .nav-item-btn-primary1 button:hover { background-color: rgb(226, 99, 14) !important; }
.btn { cursor: pointer; background: transparent; display: flex; outline: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; font: 600 14px / 1.2 "IBM Plex Sans", sans-serif; padding: 0px 24px; border-radius: 4px; min-height: 56px; min-width: 180px; max-width: 280px; text-transform: uppercase; transition: 0.2s; text-align: center; user-select: none; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; }
.btn-fluid { -webkit-box-flex: 1; flex: 1 1 0%; max-width: none; }
.btn-row { margin-left: -6px; margin-right: -6px; margin-bottom: -12px; display: flex; flex-wrap: wrap; position: relative; z-index: 2; }
.btn-row.single .btn { -webkit-box-flex: 0; flex-grow: 0; flex-basis: auto; }
.btn-row .btn { margin: 0px 6px 12px; -webkit-box-flex: 1; flex: 1 1 0%; }
*, ::after, ::before { box-sizing: border-box; margin: 0px; padding: 0px; }
body, html { height: 100%; }
body { background: rgb(24, 31, 38); color: rgb(193, 207, 219); -webkit-font-smoothing: antialiased; font: 1rem / 1.5 "IBM Plex Sans", sans-serif; letter-spacing: 0.4px; }
.site-wrapper { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; min-height: 100%; overflow: hidden; }
.wrapper { padding-top: 72px; }
ul { list-style: none; padding-left: 0px; margin-bottom: calc(var(--bs-gutter-y)*-1); }
ul:not([class*="g-"]) { --bs-gutter-y: 0; }
ul li { margin-bottom: var(--bs-gutter-y); }
ul li p { color: inherit; }
a { text-decoration: none; color: rgb(53, 146, 253); }
img { vertical-align: top; }
img.fluid { display: block; width: 100%; }
.title-section { margin-bottom: 1.5rem; }
.title-section .h2, .title-section .pretitle, .title-section h2 { max-width: 628px; }
.title-section.text-center .h2, .title-section.text-center .pretitle, .title-section.text-center h2 { margin-left: auto; margin-right: auto; }
.title-section.text-left .h2, .title-section.text-left .pretitle, .title-section.text-left h2 { max-width: none; margin-left: 0px; margin-right: 0px; text-align: left; }
.section, section { padding: 50px 0px; }
.section > .container, section > .container { position: relative; z-index: 1; }
.wrapper { overflow: hidden; -webkit-box-flex: 1; flex: 1 1 0%; }
body .zsiq_custommain, body .zsiq_floatmain { z-index: 1048 !important; }
#CybotCookiebotDialog.CybotEdge .CybotCookiebotDialogContentWrapper { display: block !important; }
#CybotCookiebotDialog { font: 1rem / 1.5 "IBM Plex Sans", sans-serif !important; }
#CybotCookiebotDialog .CybotCookiebotDialogBodyButton { font-weight: 600; transition: 0.2s; font-size: 14px !important; text-transform: uppercase !important; margin: 12px 0px 0px !important; width: 100% !important; padding-top: 17px !important; padding-bottom: 17px !important; opacity: 1 !important; }
#CybotCookiebotDialog .CybotCookiebotDialogBodyButton .CybotCookiebotDialogArrow { display: none !important; }
#CybotCookiebotDialog #CybotCookiebotDialogBodyButtons { display: block !important; max-width: none !important; }
#CybotCookiebotDialog #CybotCookiebotDialogBodyButtonsWrapper { display: block !important; max-width: none !important; width: auto !important; margin-top: 0px !important; -webkit-box-orient: horizontal !important; -webkit-box-direction: normal !important; flex-direction: row !important; }
#CybotCookiebotDialog #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll:hover { background-color: rgb(226, 99, 14); border-color: rgb(226, 99, 14); }
#CybotCookiebotDialog #CybotCookiebotDialogBodyLevelButtonCustomize:hover { border-color: rgb(130, 150, 170); background-color: rgba(33, 42, 51, 0.8) !important; }
#CybotCookiebotDialog.CybotEdge { max-width: 600px !important; min-width: 0px !important; inset: auto 20px 16px !important; transform: translateY(100%) !important; margin: 0px auto !important; width: auto !important; padding: 24px !important; }
#CybotCookiebotDialog.CybotEdge.CybotCookiebotDialogActive { transform: translate(0px) !important; }
#CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogBodyButtonsWrapper { margin-top: 24px !important; }
#CybotCookiebotDialog.CybotEdge .CybotCookiebotScrollContainer { max-height: none !important; border-bottom-width: medium !important; border-bottom-style: none !important; border-bottom-color: currentcolor !important; padding: 0px !important; }
#CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogTabContent { margin: 0px !important; }
#CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogBodyContent, #CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogFooter { padding: 0px !important; }
#CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogBodyButtonDecline { display: none !important; }
#CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogBodyContentText { font-size: 14px !important; line-height: 20px !important; }
#CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogHeader, #CybotCookiebotDialog.CybotEdge #CybotCookiebotDialogPoweredByText, #CybotCookiebotDialog.CybotEdge .CybotCookiebotDialogBodyBottomWrapper { display: none !important; }
#CybotCookiebotDialog:not(.CybotEdge) * { font-size: 14px; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogHeader, #CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogPoweredByText { display: none !important; }
#CybotCookiebotDialog:not(.CybotEdge) .CookieCard { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding-bottom: 17px; }
#CybotCookiebotDialog:not(.CybotEdge) .CookieCard .CybotCookiebotDialogDetailBodyContentCookieTypeTableContainer { padding-top: 0px; margin-left: 25px; margin-top: 24px; }
#CybotCookiebotDialog:not(.CybotEdge) .CookieCard .CybotCookiebotDialogDetailBodyEmptyCategoryMessage { margin-bottom: 0px; padding: 20px; border-color: rgb(49, 61, 73); }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotScrollContainer { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogFooter { padding: 24px; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogNav { border-color: rgb(49, 61, 73); padding-top: 20px; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogNav .CybotCookiebotDialogNavItemLink { color: rgb(130, 150, 170); font-size: 14px; padding: 10px 12px 12px; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogNav .CybotCookiebotDialogNavItemLink:hover { color: rgb(53, 146, 253); }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogNav .CybotCookiebotDialogNavItemLink.CybotCookiebotDialogActive { color: rgb(53, 146, 253); border-bottom: 2px solid rgb(53, 146, 253); }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogBodyLevelButtonSliderWrapper { height: 30px; }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogBodyLevelButtonSlider { background-color: rgb(193, 207, 219); }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogBodyLevelButtonSlider::before { background-color: rgb(255, 255, 255); height: 22px; width: 22px; }
#CybotCookiebotDialog:not(.CybotEdge) input:checked + .CybotCookiebotDialogBodyLevelButtonSlider { background-color: rgba(53, 146, 253, 0.2); }
#CybotCookiebotDialog:not(.CybotEdge) input:checked + .CybotCookiebotDialogBodyLevelButtonSlider::before { background-color: rgb(53, 146, 253); }
#CybotCookiebotDialog:not(.CybotEdge) input:focus + .CybotCookiebotDialogBodyLevelButtonSlider { box-shadow: rgba(53, 146, 253, 0.2) 0px 0px 1px; }
#CybotCookiebotDialog:not(.CybotEdge) input[type="checkbox"][disabled]:checked + .CybotCookiebotDialogBodyLevelButtonSlider { background-color: rgba(53, 146, 253, 0.2); opacity: 0.56; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogDetailFooter { padding: 12px 0px 0px; border-top: 1px solid rgb(49, 61, 73); margin: 0px 23px 0px 26px; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection { background-color: rgb(242, 126, 48); border-color: rgb(242, 126, 48); color: rgb(255, 255, 255); }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection:hover { background-color: rgb(226, 99, 14); border-color: rgb(226, 99, 14); }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogBodyButtonDecline { background-color: rgb(33, 42, 51); border-color: rgb(49, 61, 73); color: rgb(193, 207, 219); }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogBodyButtonDecline:hover { border-color: rgb(130, 150, 170); background-color: rgba(33, 42, 51, 0.8) !important; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogDetailBodyContentCookieContainerTypes { padding-left: 19px; padding-right: 15px; }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogDetailBodyContentCookieContainerHeader { color: rgb(255, 255, 255); }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogDetailBodyContentCookieContainerHeader label { color: rgb(255, 255, 255); }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogDetailBodyContentCookieContainerHeader button::before { border-color: rgb(255, 255, 255); top: 0.35em; margin-right: 20px; }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogDetailBulkConsentCount { background-color: rgb(49, 61, 73); color: rgb(255, 255, 255); padding: 3px 6px; min-width: 20px; max-height: 20px; text-align: center; margin-left: 8px; font-size: 12px !important; }
#CybotCookiebotDialog:not(.CybotEdge) .CybotCookiebotDialogDetailBodyContentCookieTypeIntro { padding-right: 68px; padding-left: 26px !important; padding-top: 12px !important; }
#CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogBodyContent, #CybotCookiebotDialog:not(.CybotEdge) #CybotCookiebotDialogDetailBodyContentTextAbout { padding-bottom: 24px; }
.section-intro img { height: auto; }
.section-intro .btn-row .btn { width: 100%; }
.section-intro .row-slider { display: flex; -webkit-box-align: center; align-items: center; margin-top: -15%; }
.section-intro .row-slider .h2 { -webkit-box-flex: 0; flex: 0 0 108px; }
.section-intro .row-slider .slider-logos-partners { -webkit-box-flex: 0; flex: 0 1 auto; width: 100%; }
