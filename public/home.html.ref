@media screen and (max-width: 1240px) {
  .h1, h1 { font-size: 28px; margin-bottom: 22px; }
  .h2, h2 { font-size: 24px; margin-bottom: 18px; }
  .h3, h3 { font-size: 22px; margin-bottom: 14px; }
}
@media screen and (max-width: 1023px) {
  .site-nav { position: fixed; inset: 72px 0px 0px; background: rgb(17, 21, 27); overflow: auto; padding-bottom: 92px; display: none; }
  .site-nav .nav-list { margin: 12px 16px 0px 32px; }
  .site-nav .nav-list > .nav-item > .nav-link { text-transform: uppercase; }
  .site-nav .item-link, .site-nav .nav-link { display: block; padding: 16px 0px; min-height: 24px; }
  .site-nav .sub-nav-list .nav-link { display: flex; -webkit-box-align: center; align-items: center; padding: 16px 0px; min-height: 24px; }
  .site-nav .group-wrap { padding-left: 16px; }
  .site-nav .group-wrap .group { position: relative; }
  .site-nav .group-wrap .group .item-link { display: flex; -webkit-box-align: center; align-items: center; padding: 16px 0px; min-height: 24px; }
  .site-nav .group-wrap .head { position: relative; }
  .site-nav .group-wrap .head::before { content: ""; border-top: 1px dotted rgb(49, 61, 73); position: absolute; top: 18px; left: 0px; right: 0px; }
  .site-nav .group-wrap .head span { position: relative; display: inline-block; z-index: 1; background: rgb(33, 42, 51); }
  .site-nav a.head { color: rgb(255, 255, 255); font-size: 14px; font-weight: 600; padding-top: 0px; }
  .site-nav a.head span { padding: 16px 0px; min-height: 24px; border-bottom: 1px dotted rgb(49, 61, 73); width: 100%; }
  .site-nav a.head span:hover { color: rgb(47, 143, 252); }
  .site-nav div.head { color: rgb(135, 153, 171); font-size: 12px; font-weight: 400; padding-top: 8px; }
  .site-nav .nav-item.opened { border-bottom-color: transparent; }
  .site-nav .nav-item { position: relative; border-bottom: 1px dotted rgb(49, 61, 73); }
  .site-nav .sub-nav-list .nav-item:last-child { border-bottom-color: transparent; }
  .site-nav .nav-item_has-sub .open-sub { position: absolute; top: 0px; right: 0px; height: 24px; width: 24px; padding-top: 16px; padding-bottom: 16px; }
  [dir="rtl"] .site-nav .nav-item_has-sub .open-sub { left: 0px; right: auto; }
  .site-nav .nav-item_has-sub .open-sub::before { width: 7px; height: 7px; margin-left: 2px; }
  .site-nav .nav-item.opened > .open-sub::before { border-color: rgb(24, 139, 255); transform: rotate(45deg); margin-top: 0px; }
  .site-nav .sub-nav { background: rgb(33, 42, 51); border-radius: 4px; padding: 0px !important; }
  .site-nav .sub-nav-list { background: rgb(24, 31, 38); padding: 0px 16px 0px 48px; margin: 0px -16px 0px -32px; }
  .site-nav .sub-nav, .site-nav .sub-nav-list { display: none; }
  .site-menu-toggled .site-nav { display: block; }
  .site-nav .nav-item_contact-us .nav-item { display: flex; padding: 18px 0px; }
  .site-nav .flags { margin: 0px 16px 0px 32px; }
  .site-nav .flags .item, .site-nav .flags a { background-repeat: no-repeat; background-position: 0px center; display: block; }
  .site-nav .flags .item span, .site-nav .flags a span { padding: 16px 0px 16px 20px; font-weight: 600; min-height: 24px; display: flex; -webkit-box-align: center; align-items: center; }
  .site-nav .flags .main-flag { background-position: 0px 23px; position: relative; }
  .site-nav .flags .main-flag::before { content: ""; position: absolute; border-top: 2px solid rgb(255, 255, 255); border-left: 2px solid rgb(255, 255, 255); transform: rotate(-135deg); width: 7px; height: 7px; right: 8px; top: 23px; }
  [dir="rtl"] .site-nav .flags .main-flag::before { left: 8px; right: auto; }
  .site-nav .flags.opened .main-flag::before { border-color: rgb(24, 139, 255); transform: rotate(45deg); top: 26px; }
  .site-nav .flags .flag-list { display: none; background: rgb(24, 31, 38); padding: 0px 16px 0px 48px; margin: 0px -16px 0px -32px; }
  .site-nav .flags .flag-list .item + .item a { border-top: 1px dotted rgb(49, 61, 73); }
  .site-nav .wrapper-nav-button { position: fixed; left: 0px; right: 0px; bottom: 0px; padding: 0px 16px; z-index: 2; background: rgb(17, 21, 27); }
  .site-nav .wrapper-nav-button .rd-btn { margin: 12px 0px 24px; width: 100%; }
  .site-menu-toggled .zsiq_float { visibility: hidden; }
  .site-nav_2025 .nav-list { margin: 12px 32px 0px; }
  .site-nav_2025 .item-link, .site-nav_2025 .nav-link { display: block; padding: 16px 0px; min-height: 20px; }
  .site-nav_2025 .sub-nav-list .nav-link { min-height: 20px; }
  .site-nav_2025 .nav-item-btn-primary1 { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }
  .site-nav_2025 .nav-item-btn-primary1 a, .site-nav_2025 .nav-item-btn-primary1 button { text-transform: uppercase; padding: 17px 15px; }
  .site-nav_2025 .nav-item:nth-last-of-type(2) { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }
  .site-nav_2025 .nav-item.btn, .site-nav_2025 .nav-item.btn a { min-height: auto; }
  .site-nav_2025 .nav-item.btn:hover > .nav-link { color: rgb(255, 255, 255); }
  .site-nav_2025 .sub-nav-list { padding: 0px 32px; margin: 0px -32px; }
  .site-nav_2025 .nav-item_products .sub-nav-list { padding-top: 16px; padding-bottom: 16px; }
  .site-nav_2025 .nav-item_product + .nav-item_product { margin-top: 16px; }
  .site-nav_2025 .nav-item_product .nav-link { padding: 16px; -webkit-box-align: start; align-items: flex-start; }
  .site-nav_2025 .nav-item_product .nav-logo { height: 30px; }
  .site-nav_2025 .flags { margin: 0px 32px; }
  .site-nav_2025 .flags .item span, .site-nav_2025 .flags a span { padding: 16px 0px; min-height: 20px; }
  .site-nav_2025 .flags .main-flag { background: none; position: relative; }
  .site-nav_2025 .flags .flag-list { padding: 0px 32px; margin: 0px -32px; }
  .btn-mob-menu { display: block; }
}
@media screen and (max-width: 991px) {
  .h3, h3 { font-size: 20px; margin-bottom: 12px; }
  .title-section .h2, .title-section .pretitle, .title-section h2 { margin-left: auto; margin-right: auto; text-align: center; }
  .section-intro img { margin: 0px auto; max-width: 90vh; }
}
@media screen and (max-width: 767px) {
  .h1, h1 { font-size: 24px; margin-bottom: 18px; }
  .h2, h2 { font-size: 22px; margin-bottom: 16px; }
  .h4, h4 { margin-bottom: 10px; }
  .h4, .text-huge, h4 { font-size: 18px; }
  .text-large { font-size: 16px; }
  .text-medium, body { font-size: 14px; }
  .section-intro .row-slider .h2 { -webkit-box-flex: 1; flex: 1 1 auto; font-size: 18px !important; }
}
@media screen and (max-height: 700px) and (max-width: 1441px) and (min-width: 992px) and (orientation: landscape) {
  section.small-desktop { padding: 4rem 0px; }
  .small-desktop.section-intro { padding-top: 2rem !important; }
  .small-desktop.section-intro img { max-height: 70vh; width: auto; margin: auto; max-width: 100%; }
}
@media screen and (max-width: 567px) {
  .btn { flex: 1 1 0%; }
  .btn, .btn-row .btn { -webkit-box-flex: 1; max-width: none; }
  .btn-row .btn { width: 100%; flex: 1 1 auto; }
}
@media screen and (max-width: 420px) {
  .section-intro img { width: 100%; margin: 0px auto; }
}
@media print {
  .d-print-inline { display: inline !important; }
  .d-print-inline-block { display: inline-block !important; }
  .d-print-block { display: block !important; }
  .d-print-grid { display: grid !important; }
  .d-print-table { display: table !important; }
  .d-print-table-row { display: table-row !important; }
  .d-print-table-cell { display: table-cell !important; }
  .d-print-flex { display: flex !important; }
  .d-print-inline-flex { display: inline-flex !important; }
  .d-print-none { display: none !important; }
