.site-nav { font-size: 14px; line-height: 20px; box-sizing: content-box; }
.site-nav *, .site-nav ::after, .site-nav ::before { box-sizing: content-box; }
.site-nav a { font-weight: 600; color: rgb(255, 255, 255); transition: color 0.1s; text-decoration: none; }
.site-nav a:focus, .site-nav a:hover { color: rgb(47, 143, 252); }
.site-nav .nav-item_has-sub .open-sub { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; margin-left: auto; }
.site-nav .nav-item_has-sub .open-sub::before { content: ""; width: 5px; height: 5px; border-top: 2px solid rgb(255, 255, 255); border-left: 2px solid rgb(255, 255, 255); transform: rotate(-135deg); margin: -3px 0px 0px 4px; transition: border-color 0.1s; }
[dir="rtl"] .site-nav .nav-item_has-sub .open-sub::before { margin: -3px 8px 0px -4px; }
.site-nav .nav-item_contact-us .nav-item { padding: 8px 0px; }
