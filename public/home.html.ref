.site-header { z-index: 100; position: fixed; top: 0px; left: 0px; right: 0px; height: 72px; background-color: rgb(24, 31, 38); box-shadow: rgba(0, 0, 0, 0.4) 0px 0px 32px; }
.site-header .container, .site-header .logo { display: flex; -webkit-box-align: center; align-items: center; height: 100%; }
.site-header .logo { position: relative; z-index: 1; top: -2px; }
.site-header .hat { position: absolute; top: 11px; left: -16px; width: 58px; height: 21px; background: rgb(255, 255, 255); border-radius: 118px / 80px; transform: rotate(-33deg); z-index: 1; box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 4px; }
.site-header .hat::before { content: ""; background: rgb(47, 143, 252); position: absolute; top: -5px; left: 8px; height: 16px; width: 42px; border-radius: 112px 260px 0px 0px; z-index: -1; }
.site-header .hat::after { content: ""; position: absolute; top: 9px; left: -20px; width: 0px; height: 0px; border-left: 32px solid transparent; border-right: 12px solid transparent; border-top: 11px solid rgb(47, 143, 252); border-radius: 74px; z-index: -2; transform: rotate(-50deg); }
.site-header .hat-part { position: absolute; top: 18px; left: -16px; width: 10px; height: 10px; background: rgb(255, 255, 255); border-radius: 50%; }
.site-header .js-progress-bar { position: absolute; bottom: -4px; left: 0px; height: 4px; transition: 0.1s; }
