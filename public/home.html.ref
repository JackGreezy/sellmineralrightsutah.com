 height="244" style="height: auto;" src="/assets-f/img/8d27e0f1901e7f.jpg" data-ll-status="loaded"></picture> </div> <h3 class="h4">Finance &amp; insurance</h3> </a> </div></div><div class="owl-item"><div class="card-industry"> <a class="link radius-md" href="#" target="_blank" rel="noopener" onclick="dataLayer.push({'event':'EOSCOM', 'eventCategory':'EosComEvents', 'eventAction':'more_info_button', 'eventLabel':'industries', 'eventContent':'', 'eventPosition':'security', 'eventContext':''});"> <div class="image"> <picture><source srcset="/assets-f/img/0e3729df2b6fab.webp" media="(max-width: 768px)" type="image/webp" srcset="/assets-f/img/0e3729df2b6fab.webp"><source srcset="/assets-f/img/0e3729df2b6fab.webp" media="(max-width: 1024px)" type="image/webp" srcset="/assets-f/img/0e3729df2b6fab.webp"><img class="lazy entered loaded" data-src="/assets-f/img/96755b5e668ca5.jpg" alt="Border monitoring and situational awareness through satellite surveillance due to EOS Data Analytics tools for security." width="239" height="244" style="height: auto;" src="/assets-f/img/96755b5e668ca5.jpg" data-ll-status="loaded"></picture> </div> <h3 class="h4">Security</h3> </a> </div></div><div class="owl-item"><div class="card-industry"> <a class="link radius-md" href="#" target="_blank" rel="noopener" onclick="dataLayer.push({'event':'EOSCOM', 'eventCategory':'EosComEvents', 'eventAction':'more_info_button', 'eventLabel':'industries', 'eventContent':'', 'eventPosition':'agro_carbon_markets', 'eventContext':''});"> <div class="image"> <picture><source srcset="/assets-f/img/7aae5dc961a385.webp" media="(max-width: 768px)" type="image/webp" srcset="/assets-f/img/7aae5dc961a385.webp"><source srcset="/assets-f/img/7aae5dc961a385.webp" media="(max-width: 1024px)" type="image/webp" srcset="/assets-f/img/7aae5dc961a385.webp"><img class="lazy entered loaded" data-src="/assets-f/img/7b3a83ce03828e.jpg" alt="EOS Data Analytics for Carbon Markets: Digital monitoring and verification of soil carbon sequestration." width="239" height="244" style="height: auto;" src="/assets-f/img/7b3a83ce03828e.jpg" data-ll-status="loaded"></picture> </div> <h3 class="h4">Agro carbon markets &amp; dMRV</h3> </a> </div></div></div></div><div class="owl-controls"><div class="owl-nav disabled"><button type="button" role="presentation" class="owl-prev"><span aria-label="Previous">‹</span></button><button type="button" role="presentation" class="owl-next"><span aria-label="Next">›</span></button></div><div class="owl-dots disabled"></div></div></div> </div> </section> <section class="section-our-satellites bg-primary small-desktop"> <div class="bg"> <img class="fluid lazy" data-src="/assets-f/img/9f26fcc55866b9.png" alt="The satellite fleet behind your insights" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%201%201'%3E%3C/svg%3E"> </div> <div class="container"> <div class="row"> <div class="col-lg-6 ms-lg-auto"> <header class="title-section mb-4"> <h2 class="h3">The satellite fleet behind your insights</h2> </header> <div class="text-primary text-huge"> <p>EOS Data Analytics provides solutions for any corner of the globe by combining exclusive data stream from EOS SAT-1 with an additional extensive network of over 20 satellite constellations.</p> <p>Due to the partnership with optical, SAR, and thermal data providers, we offer everything from high-resolution to ultra-high-resolution imagery and analytics on top of it.</p> </div> <div class="btns-row mt-4 mt-sm-6 flex-sm-nowrap"> <button class="btn btn-primary1" onclick="dataLayer.push({'event':'EOSCOM', 'eventCategory':'EosComEvents', 'eventAction':'demo_request_button', 'eventLabel':'our_satellites', 'eventContent':'', 'eventPosition':'lv', 'eventContext':'Contact us'});sessionStorage.setItem('#modalEosContactUs', JSON.stringify({ 'modal-autocomplete': { 'subject' : 'Contact us', 'product' : 'EOSDA LandViewer' }, 'events-form' : {'eventLabel':'our_satellites', 'eventPosition' : 'lv'} }) );" data-bs-toggle="modal" data-bs-target="#modalEosContactUs">Contact us</button><a class="btn btn-secondary" onclick="dataLayer.push({'event':'EOSCOM', 'eventCategory':'EosComEvents', 'eventAction':'more_info_button', 'eventLabel':'our_satellites', 'eventContent':'', 'eventPosition':'lv', 'eventContext':''});" href="#" target="_blank">Explore all data sources</a> </div> </div> </div> </div> </section> <section class="section-partners bg-third small-desktop"> <div class="container"> <header class="title-section text-center"> <h2>EOS Data Analytics partner ecosystem</h2> </header> <div class="slider-mob-card-partners owl-carousel owl-loaded owl-drag">         <div class="owl-stage-outer"><div class="owl-stage" style="left: 0px; width: 1627px;"><div class="owl-item active" style="width: 183.333px; margin-right: 20px;"><div class="item d-flex justify-content-center"> <img class="lazy" data-src="/assets-f/img/62560d9ca10d9c.svg" alt="21AT as a data provider for EOS Data Analytics" width="200" height="80" style="height: auto;" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%2080'%3E%3C/svg%3E"> </div></div><div class="owl-item active" style="width: 183.333px; margin-right: 20px;"><div class="item d-flex justify-content-center"> <img class="lazy" data-src="/assets-f/img/97c460cabe8d2f.svg" alt="SIIS as a data provider for EOS Data Analytics" width="200" height="80" style="height: auto;" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%2080'%3E%3C/svg%3E"> </div></div><div class="owl-item active" style="width: 183.333px; margin-right: 20px;"><div class="item d-flex justify-content-center"> <img class="lazy" data-src="/assets-f/img/b23b38f78ad6a7.svg" alt="SpaceWill as a data provider for EOS Data Analytics" width="200" height="80" style="height: auto;" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%2080'%3E%3C/svg%3E"> </div></div><div class="owl-item 