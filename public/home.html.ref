  .col-lg-1, .col-lg-auto { -webkit-box-flex: 0; flex: 0 0 auto; }
  .col-lg-1 { width: 8.33333%; }
  .col-lg-2 { width: 16.6667%; }
  .col-lg-2, .col-lg-3 { -webkit-box-flex: 0; flex: 0 0 auto; }
  .col-lg-3 { width: 25%; }
  .col-lg-4 { width: 33.3333%; }
  .col-lg-4, .col-lg-5 { -webkit-box-flex: 0; flex: 0 0 auto; }
