  .col-sm-5 { width: 41.6667%; }
  .col-sm-6 { width: 50%; }
  .col-sm-6, .col-sm-7 { -webkit-box-flex: 0; flex: 0 0 auto; }
  .col-sm-7 { width: 58.3333%; }
  .col-sm-8 { width: 66.6667%; }
  .col-sm-8, .col-sm-9 { -webkit-box-flex: 0; flex: 0 0 auto; }
  .col-sm-9 { width: 75%; }
  .col-sm-10 { width: 83.3333%; }
  .col-sm-10, .col-sm-11 { -webkit-box-flex: 0; flex: 0 0 auto; }
  .col-sm-11 { width: 91.6667%; }
  .col-sm-12 { -webkit-box-flex: 0; flex: 0 0 auto; width: 100%; }
  .offset-sm-0 { margin-left: 0px; }
