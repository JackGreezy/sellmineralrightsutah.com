  .section, section { padding: 5rem 0px; }
  .container { padding-left: 3.5rem; padding-right: 3.5rem; }
  .section-intro .row-slider { margin-top: -24px; }
}
@media screen and (min-width: 1024px) {
  .site-nav { -webkit-box-flex: 1; flex: 1 1 0%; display: flex; height: 100%; font-size: 12px; }
  .site-nav .nav-item_contact-us .crop { padding-bottom: 6px; }
  .site-nav .nav-list { margin: 0px auto; height: 100%; }
  .site-nav .nav-item, .site-nav .nav-list { display: flex; }
  .site-nav .nav-item { margin: 0px 8px; white-space: nowrap; }
  .site-nav .nav-item:hover > .open-sub::before { border-color: rgb(47, 143, 252); }
  .site-nav .nav-item:hover > .nav-link { color: rgb(47, 143, 252); }
  .site-nav .nav-item:hover .sub-nav-list { transform: none; opacity: 1; pointer-events: auto; transition: transform 0.3s 0.1s, opacity 0.3s 0.1s, -webkit-transform 0.3s 0.1s; }
  .site-nav .nav-list > .nav-item_has-sub { position: relative; }
  .site-nav .nav-list > .nav-item_has-sub::before { content: ""; position: absolute; border-color: transparent transparent rgb(33, 42, 51); border-style: solid; border-width: 0px 7px 8px; left: 50%; transform: translate(-50%, 6px); bottom: 12px; z-index: 2; opacity: 0; transition: transform 0.2s 0.05s, opacity 0.2s 0.05s, -webkit-transform 0.2s 0.05s; }
  .site-nav .nav-list > .nav-item_has-sub:hover::before { opacity: 1; transition: transform 0.3s 0.1s, opacity 0.3s 0.1s, -webkit-transform 0.3s 0.1s; transform: translate(-50%); }
  .site-nav .sub-nav-list { position: absolute; top: 100%; background-color: rgb(33, 42, 51); box-shadow: rgba(0, 0, 0, 0.4) 0px 0px 50px; border-radius: 4px; padding: 16px; margin: -12px 0px 0px -16px; opacity: 0; transition: transform 0.2s 0.05s, opacity 0.2s 0.05s, -webkit-transform 0.2s 0.05s; transform: translateY(6px); pointer-events: none; min-width: 220px; }
  .site-nav .sub-nav-list .item-link, .site-nav .sub-nav-list .nav-link { white-space: normal; line-height: 21px; font-size: 14px; }
  .site-nav .sub-nav-list .nav-link { font-size: 14px; }
  .site-nav .sub-nav-list .nav-item { margin: 0px; padding: 6px 0px; }
  .site-nav .sub-nav-list .nav-item:hover .sub-nav { pointer-events: auto; opacity: 1; transform: none; transition: transform 0.2s 0.05s, opacity 0.2s 0.05s, -webkit-transform 0.2s 0.05s; }
  .site-nav .sub-nav-list .nav-item:first-of-type { padding-top: 0px; }
  .site-nav .sub-nav-list .nav-item:last-of-type { padding-bottom: 0px; }
  .site-nav .sub-nav-list .nav-item .open-sub::before { transform: rotate(135deg); margin: 0px 1px 0px auto; position: relative; z-index: 1; }
  .site-nav .sub-nav-list .nav-item_has-sub:hover::before { content: ""; position: absolute; width: 60px; right: 0px; bottom: 0px; top: 0px; z-index: 2; }
  .site-nav .sub-nav-list .nav-link { margin-right: 6px; position: relative; z-index: 1; }
  .site-nav .sub-nav { display: flex; position: absolute; left: 0px; background-color: rgb(33, 42, 51); top: 0px; min-height: 100%; border-radius: 4px; pointer-events: none; opacity: 0; transition: transform 0.2s 0.5s, opacity 0.1s 0.5s, -webkit-transform 0.2s 0.5s; transform-origin: left top; transform: scale(0.8); }
  .site-nav .nav-item:nth-child(2) .sub-nav { transform: scaleX(0.8); }
  .site-nav .nav-link { -webkit-box-align: center; align-items: center; padding: 0px; line-height: 24px; font-size: 14px; }
  .site-nav .group-wrap, .site-nav .nav-link { display: flex; }
  .site-nav .group-wrap { border-left: 1px solid rgb(44, 55, 67); margin: 16px 0px; padding: 0px 16px; }
  .site-nav .group { width: 220px; margin: 0px 16px 0px 0px; letter-spacing: 0.4px; }
  .site-nav .group:last-child { margin-right: 0px; }
  .site-nav .group .head { margin: 0px 0px 12px; padding: 0px; font-weight: 600; font-size: 14px; }
  .site-nav .group a { display: block; font-weight: 400; line-height: 24px; color: rgb(193, 207, 219); }
  .site-nav .group a:hover { color: rgb(47, 143, 252); }
  .site-nav .group .nav-item { padding: 4px 0px; }
  .site-nav .flags { display: flex; -webkit-box-align: center; align-items: center; }
  .site-nav .flags:hover .main-flag { background-color: rgb(33, 42, 51); }
  .site-nav .flags:hover .flag-list { opacity: 1; pointer-events: auto; transition: transform 0.2s 0.1s, opacity 0.2s 0.1s, -webkit-transform 0.2s 0.1s; transform: none; }
  .site-nav .flags .main-flag { position: relative; background-repeat: no-repeat; background-position: left 8px center; padding: 3px 8px; border-radius: 4px; display: flex; cursor: default; }
  .site-nav .flags .main-flag span { padding-left: 20px; }
  .site-nav .flags .flag-list { position: absolute; top: 100%; padding: 16px; border-radius: 4px; background-color: rgb(33, 42, 51); box-shadow: rgba(0, 0, 0, 0.4) 0px 0px 50px; opacity: 0; right: 0px; margin-top: 10px; pointer-events: none; transition: transform 0.1s 0.05s, opacity 0.1s 0.05s, -webkit-transform 0.1s 0.05s; transform: translateY(6px); }
  .site-nav .flags .flag-list::before { content: ""; position: absolute; border-color: transparent transparent rgb(33, 42, 51); border-style: solid; border-width: 0px 7px 8px; left: 60%; top: -8px; z-index: 2; }
  .site-nav .flags .flag-list .item a { position: relative; background-repeat: no-repeat; background-position: left 8px center; display: block; padding: 6px 8px; }
  .site-nav .flags .flag-list .item a span { padding-left: 20px; }
  .site-nav .flags .flag-list .item.select a { background-color: rgb(24, 31, 38); }
  .site-nav .wrapper-nav-button { display: flex; -webkit-box-align: center; align-items: center; min-width: 180px; margin: 0px 20px 0px -20px; }
  .site-nav .wrapper-nav-button:empty { min-width: 0px; }
  .site-nav .wrapper-nav-button .rd-btn { min-height: 40px; }
  .site-nav_2025 .nav-item { margin: 0px 13px; }
  .site-nav_2025 .nav-item-btn-primary1 a, .site-nav_2025 .nav-item-btn-primary1 button { padding: 16px 15px; }
  .site-nav_2025 .nav-list > .nav-item_has-sub::before { display: none; }
  .site-nav_2025 .sub-nav-list { padding: 20px 30px; margin: 0px 0px 0px -30px; min-width: max-content; }
  .site-nav_2025 .sub-nav-list .nav-link { margin-right: 0px; }
  .site-nav_2025 .nav-item_products { position: inherit !important; }
  .site-nav_2025 .nav-item_products .sub-nav-list { padding: 15px 20px; display: flex; gap: 20px; transform: translate(-50%, 6px); left: 50%; margin: 0px; }
  .site-nav_2025 .nav-item_products:hover .sub-nav-list { transform: translateX(-50%); }
  .site-nav_2025 .nav-item_product .nav-link { width: 310px; padding: 20px; -webkit-box-align: start; align-items: flex-start; }
  .site-nav_2025 .nav-item_product .nav-logo { height: 64px; }
  .site-nav_2025 .flags .main-flag { background: none; padding: 3px 22px 3px 8px; }
  .site-nav_2025 .flags .main-flag span { padding-left: 0px; }
  .site-nav_2025 .flags .main-flag::after { display: block; content: ""; position: absolute; right: 8px; top: calc(50% - 2px); width: 5px; height: 5px; border-top: 2px solid rgb(193, 207, 219); border-left: 2px solid rgb(193, 207, 219); transform: rotate(-135deg); margin: -3px 0px 0px 4px; }
  [dir="rtl"] .site-nav_2025 .flags .main-flag::after { left: -17px; right: auto; }
  .site-nav_2025 .flags .flag-list::before { display: none; }
  .site-nav_2025 .flags .flag-list .item a { background: none; }
  .site-nav_2025 .flags .flag-list .item a span { padding-left: 0px; }
  #CybotCookiebotDialog.CybotEdge { max-width: 844px !important; }
}
@media screen and (min-width: 1200px) {
  .site-nav { font-size: 14px; }
