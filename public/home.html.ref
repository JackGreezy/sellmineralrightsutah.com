.btn-mob-menu { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; height: 100%; width: 72px; display: none; margin: 0px -15px 0px auto; }
[dir="rtl"] .btn-mob-menu { margin: 0px auto 0px -15px; }
.btn-mob-menu span { position: relative; display: inline-block; width: 21.33px; height: 21.33px; border-top: 2px solid rgb(255, 255, 255); border-bottom: 2px solid rgb(255, 255, 255); vertical-align: middle; }
.btn-mob-menu span::after, .btn-mob-menu span::before { content: ""; height: 2.4px; width: 100%; position: absolute; top: 50%; left: 0px; right: 0px; margin-top: -1px; background-color: rgb(255, 255, 255); transition: transform 0.4s, -webkit-transform 0.4s; }
.site-menu-toggled .btn-mob-menu span { border-color: transparent; }
.site-menu-toggled .btn-mob-menu span::before { transform: rotate(45deg); }
.site-menu-toggled .btn-mob-menu span::after { transform: rotate(-45deg); }
.site-menu-toggled { overflow: hidden; }
.site-nav_2025 .nav-item_product { padding: 0px !important; }
.site-nav_2025 .nav-item_product .nav-link { box-sizing: border-box; position: relative; white-space: normal; height: 100%; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; background-color: rgb(24, 31, 38); border-radius: 8px; border: 1px solid rgb(49, 61, 73); }
.site-nav_2025 .nav-item_product .nav-logo { width: 100%; background-repeat: no-repeat; background-position: 0px center; background-size: contain; }
[dir="rtl"] .site-nav_2025 .nav-item_product .nav-logo { background-position: 100% center; }
.site-nav_2025 .nav-item_product .nav-title { margin: 16px 0px 10px; font-size: 16px; color: rgb(255, 255, 255); }
.site-nav_2025 .nav-item_product .nav-description { font-weight: 400; color: rgb(130, 150, 170); margin-bottom: 10px; }
.site-nav_2025 .nav-item_product .btn-link { margin-top: auto; display: inline-flex; -webkit-box-align: center; align-items: center; text-decoration: underline; font-size: 14px; text-transform: none; transition: 0.3s; }
.site-nav_2025 .nav-item_product .btn-link::after { content: ""; display: inline-block; margin-left: 2px; width: 18px; height: 12px; background-color: currentcolor; mask: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M13.025 1l-1.447 1.441L21.106 12H0v2h21.106l-9.528 9.559L13.025 25 25 13z'/%3E%3C/svg%3E") center center / contain no-repeat; transition: transform 0.3s ease-in-out, -webkit-transform 0.3s ease-in-out; }
[dir="rtl"] .site-nav_2025 .nav-item_product .btn-link::after { transform: rotate(180deg); }
.site-nav_2025 .nav-item_product .btn-link:hover { text-decoration: none; }
.site-nav_2025 .nav-item_product .btn-link:hover::after { transform: translateX(4px); }
[dir="rtl"] .site-nav_2025 .nav-item_product .btn-link:hover::after { transform: rotate(180deg) translateX(4px); }
