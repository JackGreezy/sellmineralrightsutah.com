        <article><!-- STATIC CONTENT START time: 14:30:07 - 30.07.26 --> <section class="section-intro bg-third pt-md-4 pb-md-8 pt-3 small-desktop"> <div class="container"> <div class="row align-items-center"> <div class="col-md-10 offset-md-1 col-lg-5 offset-lg-0 order-3 order-lg-1 pt-2 pt-md-0"> <h1 class="mb-3">From raw satellite data to advanced AI-driven intelligence</h1> <p class="text-primary text-large"></p> <div class="btn-row mt-7 d-flex justify-content-center justify-content-lg-start"> <a class="btn btn-primary1" onclick="dataLayer.push({'event':'EOSCOM', 'eventCategory':'EosComEvents', 'eventAction':'try_now_button', 'eventLabel':'first_section', 'eventContent':'', 'eventPosition':'lv', 'eventContext':'Explore imagery'});" href="#">Explore imagery</a><button class="btn btn-primary-outline" onclick="dataLayer.push({'event':'EOSCOM', 'eventCategory':'EosComEvents', 'eventAction':'demo_request_button', 'eventLabel':'first_section', 'eventContent':'', 'eventPosition':'general', 'eventContext':'Talk to our expert'});sessionStorage.setItem('#modalEosContactUs', JSON.stringify({ 'modal-autocomplete': { 'subject' : 'Talk to our expert', 'product' : 'General' }, 'events-form' : {'eventLabel':'first_section', 'eventPosition' : 'general'} }) );" data-bs-toggle="modal" data-bs-target="#modalEosContactUs">Talk to our expert</button> </div> </div> <div class="row-slider order-2 order-lg-3 flex-column flex-md-row"> <p class="h2 mb-0">Trusted by:</p> <div class="slider-logos-partners"> <div class="slider-inner animation"> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/ee25821c78864d.svg" alt="The World Bank" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/304cb096b82be0.svg" alt="Cambridge Technology" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/26b242a081ee70.svg" alt="Bayer" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/55b2ba7ca6596b.svg" alt="Space Technology For Farmers" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/31d505e3f97364.svg" alt="Apriprove" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/0fad4bef1c9aea.svg" alt="Syngenta" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/5a119c6d544ba1.svg" alt="Forico" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/ac52d1192f79df.svg" alt="Expedite Justice" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/51d42537394afb.svg" alt="Raizen" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/b090e07426c753.svg" alt="CHS" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/35c5b1a5bf97f7.svg" alt="TelOne" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/849b9dde0c62a6.svg" alt="Golden Eye" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/8d6f4453624a46.svg" alt="Georgian Farmers" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/9d47dd233edea9.svg" alt="AgroXchange" width="140" height="140" style="height: auto;"> </div> <div class="item"> <img data-no-lazy="1" loading="eager" src="/assets-f/img/ee25821c78